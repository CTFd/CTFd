# Configuration de PRODUCTION. Ce fichier est un modele : `make tls-init`
# remplace __CTF_DOMAIN__ par le domaine reel et l'installe comme
# configuration active.

upstream ctfd {
    server ctfd:8000;
}

# Derriere le proxy Cloudflare (mode Full strict, certificat d'origine) :
# vraies IP clients. Fichier vide/absent = front expose en direct.
include /etc/nginx/conf.d/cloudflare-realip.inc;

proxy_cache_path /var/cache/nginx levels=1:2 keys_zone=ctfd_static:10m
                 max_size=256m inactive=60m use_temp_path=off;

# Toute requete dont le Host ne correspond pas au domaine du CTF est fermee
# sans reponse. Sans ce bloc, un serveur par defaut accepterait n'importe quel
# Host et rouvrirait la porte que proxy-headers.inc vient de fermer.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/letsencrypt/live/__CTF_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CTF_DOMAIN__/privkey.pem;

    return 444;
}


# --- HTTP : ACME + redirection HTTPS (vitrine apex + plateforme arena) -------
server {
    listen 80;
    server_name __CTF_DOMAIN__ www.__CTF_DOMAIN__ arena.__CTF_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- www.__CTF_DOMAIN__ -> apex (vitrine) -----------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name www.__CTF_DOMAIN__;
    ssl_certificate     /etc/letsencrypt/live/__CTF_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CTF_DOMAIN__/privkey.pem;
    return 301 https://__CTF_DOMAIN__$request_uri;
}

# --- __CTF_DOMAIN__ : VITRINE statique (site de presentation) ----------------
server {
    listen 443 ssl;
    http2 on;
    server_name __CTF_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__CTF_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CTF_DOMAIN__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    root /usr/share/nginx/vitrine;
    index index.html;
    error_page 404 /404.html;

    location / {
        try_files $uri $uri/ =404;
    }
    # Un add_header dans un location annule l'heritage de ceux du server :
    # on redeclare donc les en-tetes de securite dans chaque bloc statique.
    # Pas de "immutable" : les fichiers ne portent pas d'empreinte dans leur nom,
    # une refonte doit atteindre les visiteurs sans attendre 30 jours.
    location ~* \.(css|js)$ {
        expires 1h;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header X-Frame-Options           "SAMEORIGIN" always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    }
    location ~* \.ttf$ {
        types { }
        default_type font/ttf;
        expires 30d;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header X-Frame-Options           "SAMEORIGIN" always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    }
    location ~* \.(jpg|jpeg|png|gif|ico|svg|woff|woff2|eot)$ {
        expires 7d;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header X-Frame-Options           "SAMEORIGIN" always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    }
    location ~ /\. { deny all; access_log off; log_not_found off; }
}

# --- arena.__CTF_DOMAIN__ : plateforme CTFd (ancien front) -------------------
server {
    listen 443 ssl;
    http2 on;
    server_name arena.__CTF_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__CTF_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CTF_DOMAIN__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

    client_max_body_size 100M;

    location / {
        proxy_pass http://ctfd;
        include /etc/nginx/conf.d/proxy-headers.inc;
    }

    location /themes/ {
        proxy_pass        http://ctfd;
        proxy_cache       ctfd_static;
        proxy_cache_valid 200 60m;
        include /etc/nginx/conf.d/proxy-headers.inc;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header X-Frame-Options           "SAMEORIGIN" always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
        add_header X-Cache-Status $upstream_cache_status;
    }
}
